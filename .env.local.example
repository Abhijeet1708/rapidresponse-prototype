# Supabase Configuration
# The URL to your Supabase project (find this in Settings > API)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url-here

# The anon public key for your Supabase project
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Authentication
# Secret used to sign the HTTP-only session cookie (generate a random 32-character string)
SESSION_SECRET=your-random-32-char-secret-string-here

# Demo credentials for staff dashboard login
DEMO_USERNAME=demo
DEMO_PASSWORD=rapidresponse
